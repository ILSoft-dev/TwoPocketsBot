# Базовые — без них бот не запустится
BOT_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=
GROQ_API_KEY=
REDIS_URL=redis://localhost:6379/0

# Google OAuth (Drive/Sheets, drive.file scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Защита /cron/daily от посторонних вызовов
CRON_SECRET=

# Опционально — у всех есть дефолт в config.py, менять только при необходимости
PORT=8080
SHEETS_CACHE_TTL_SECONDS=60
GOOGLE_HTTP_TIMEOUT_SECONDS=20
SUPABASE_KEEPALIVE_INTERVAL_SECONDS=21600
GUIDE_URL=

# Опционально — переопределить модель Groq без передеплоя кода
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=
GROQ_WHISPER_MODEL=
